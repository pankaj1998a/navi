{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["bwrap", "icacls", "musl-gcc", "python3", "sandbox-exec", "tar", "taskkill", "where.exe"],
  "ignoreWorkspaces": ["vendor/*"],
  "ignoreDependencies": ["lightningcss"],
  "workspaces": {
    ".": {
      "entry": ["script/**/*.ts", "scripts/**/*.cjs"],
      "project": ["script/**/*.ts", "scripts/**/*.cjs"]
    },
    "packages/navi": {
      "entry": [
        "test/**/*.test.{ts,tsx}",
        "test/verify_merged_repos_features.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      "ignore": [
        "test/fixture/**",
        "test/fixtures/**",
        "test/memory/abort-leak-webfetch.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "test/**/*.test.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "e2e/**/*.spec.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "packages/*/*": {
      "entry": [
        "test/**/*.test.{ts,tsx}",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "packages/console/*": {
      "entry": ["test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  }
}
