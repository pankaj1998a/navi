  },
  "devDependencies": {
    "@a2a-js/sdk": "0.3.9",
    "@actions/artifact": "5.0.1",
    "@eslint/js": "9.39.2",
    "@google/genai": "1.38.0",
    "@octokit/webhooks-types": "7.6.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "@tsconfig/bun": "catalog:",
    "@types/babel__core": "7.20.5",
    "@types/bun": "catalog:",
    "@types/diff": "8.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.13.9",
    "@types/shell-quote": "1.7.5",
    "@types/turndown": "5.0.6",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.2.0",
    "google-auth-library": "10.5.0",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "sst": "3.17.23",
    "turbo": "2.5.6",
    "vitest": "4.0.17",
    "vscode-languageserver-types": "3.17.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@navi-ai/plugin": "workspace:*",
    "@navi-ai/script": "workspace:*",
    "@navi-ai/sdk": "workspace:*",
    "@solid-primitives/event-bus": "1.1.2",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pankaj1998a/navi"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
