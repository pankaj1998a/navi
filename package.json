{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "navi",
  "description": "Navi - AI-powered coding IDE & CLI with parallel agents",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bun run --cwd packages/navi --conditions=browser src/index.ts",
    "typecheck": "bun turbo typecheck",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk/js",
      "packages/slack",
      "github"
    ],
    "catalog": {
      "@types/bun": "1.3.4",
      "@types/diff": "8.0.0",
      "@babel/core": "7.24.0",
      "@types/babel__core": "7.20.5",
      "@octokit/rest": "22.0.0",
      "@hono/zod-validator": "0.4.2",
      "@corvu/utils": "0.4.2",
      "defu": "6.1.4",
      "radix3": "1.1.2",
      "ufo": "1.5.4",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@types/luxon": "3.7.1",
      "@types/node": "22.13.9",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.0.2",
      "@solid-primitives/storage": "4.3.3",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.2",
      "dompurify": "3.3.1",
      "ai": "5.0.119",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "regex": "6.1.0",
      "regex-recursion": "6.0.2",
      "remeda": "2.26.0",
      "shiki": "3.20.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "virtua": "0.42.3",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "^1.2.1",
      "solid-js": "1.9.10",
      "solid-prevent-scroll": "0.1.10",
      "vite-plugin-solid": "2.11.10"
