# .env.example — Copy to .env and fill real values. NEVER commit .env.
# cp .env.example .env

# ── Navi server ────────────────────────────────────────────────────────────────
NAVI_SERVER_PASSWORD=change-me-strong-password
# PORT override (default: 4096, or 0 for auto)
# PORT=4096
# HOSTNAME override (default: 127.0.0.1, or 0.0.0.0 with mDNS)
# HOSTNAME=127.0.0.1

# ── Auth / Config content overrides (optional) ────────────────────────────────
# NAVI_CONFIG_CONTENT=
# NAVI_AUTH_CONTENT=

# ── Sentry (optional, for error reporting) ───────────────────────────────────
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_RELEASE=
# VITE_SENTRY_RELEASE=

# ── Cloudflare (for deployment targets) ─────────────────────────────────────
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_GATEWAY_ID=

# ── OpenTelemetry (optional) ────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_RESOURCE_ATTRIBUTES=

# ── LLM provider keys (optional, per-provider) ──────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# AZURE_RESOURCE_NAME=

# ── Test flags ───────────────────────────────────────────────────────────────
# CI=false
# NAVI_TEST=
