    "./v2": "./src/v2/index.ts",
    "./v2/client": "./src/v2/client.ts",
    "./v2/server": "./src/v2/server.ts",
    "./util/*": "./src/util/*.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.88.1",
    "@tsconfig/node22": "22.0.2",
    "@types/diff": "8.0.0",
    "@types/node": "22.13.9",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "diff": "8.0.2",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "publishConfig": {
    "directory": "dist"
  }
