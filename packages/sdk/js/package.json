{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@navi-ai/sdk",
  "version": "1.1.17",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun ./script/build.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
