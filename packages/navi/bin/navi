#!/usr/bin/env node

// Navi CLI - Platform-specific binary launcher
// This script finds and runs the appropriate native binary for the user's platform

import { spawnSync } from "node:child_process";
import { existsSync, realpathSync, readdirSync } from "node:fs";
import { dirname, join } from "node:path";
import { platform as osPlatform, arch as osArch } from "node:os";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

function run(target, args = process.argv.slice(2), opts = {}) {
  const result = spawnSync(target, args, {
    stdio: "inherit",
    cwd: opts.cwd || process.cwd()
  });
  if (result.error) {
    console.error(result.error.message);
    process.exit(1);
  }
  const code = typeof result.status === "number" ? result.status : 0;
  process.exit(code);
}

// Check for explicit binary path override
const envPath = process.env.NAVI_BIN_PATH || process.env.navi_BIN_PATH;
if (envPath) {
  run(envPath);
}

const scriptPath = realpathSync(__filename);
const scriptDir = dirname(scriptPath);
const rootDir = join(scriptDir, "..");

// 1. Check for development mode (running from source)
const sourceEntry = join(rootDir, "src", "index.ts");
if (existsSync(sourceEntry)) {
  // If we are in the source tree, run using bun
  run("bun", ["run", "--conditions=browser", sourceEntry, ...process.argv.slice(2)], { cwd: rootDir });
}

const platformMap = {
  darwin: "darwin",
  linux: "linux",
  win32: "windows",
};
const archMap = {
  x64: "x64",
  arm64: "arm64",
  arm: "arm",
};

let platform = platformMap[osPlatform()];
if (!platform) {
  platform = osPlatform();
}
let arch = archMap[osArch()];
if (!arch) {
  arch = osArch();
}

// Package names for platform-specific binaries
const base = "navi-ai-agent-" + platform + "-" + arch;
const binary = platform === "windows" ? "navi.exe" : "navi";

// 2. Check for local dist folder (after build)
const localDist = join(rootDir, "dist", base, "bin", binary);
if (existsSync(localDist)) {
  run(localDist);
}

function findBinary(startDir) {
  let current = startDir;
  for (; ;) {
    const modules = join(current, "node_modules");
    if (existsSync(modules)) {
      const entries = readdirSync(modules);
      for (const entry of entries) {
        if (!entry.startsWith(base)) {
          continue;
        }
        const candidate = join(modules, entry, "bin", binary);
        if (existsSync(candidate)) {
          return candidate;
        }
      }
    }
    const parent = dirname(current);
    if (parent === current) {
      return;
    }
    current = parent;
  }
}

const resolved = findBinary(scriptDir);
if (!resolved) {
  console.error(`
Navi CLI binary not found for your platform (${platform}-${arch}).

To install Navi, run:
  npm install -g navi-ai-agent

Or manually install the platform-specific package:
  npm install -g ${base}

For more information, visit: https://github.com/pankaj1998a/navi
`);
  process.exit(1);
}

run(resolved);
