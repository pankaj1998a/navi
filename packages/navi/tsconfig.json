{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "customConditions": [
      "browser"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@tui/*": [
        "./src/cli/cmd/tui/*"
      ],
      "@navi-ai/util/*": [
        "../util/src/*"
      ],
      "@navi-ai/sdk/*": [
        "../sdk/js/src/*"
      ],
      "@navi-ai/native": [
        "../native/src/index.ts"
      ]
    },
    "incremental": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "parsers-config.ts",
    "script/**/*",
    "../../script/**/*",
    "../../packages/**/script/**/*",
    "test/**/*",
    "../util/src/**/*",
    "../sdk/js/src/**/*",
    "../native/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}