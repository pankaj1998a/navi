{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      "@tui/*": ["./src/cli/cmd/tui/*"],
      "@test/*": ["./test/*"],
      // effect 4.0.0-beta.74 moved these modules under `effect/unstable/*`.
      // Test-only compatibility shims (test/shims) keep pre-migration specifiers
      // resolving without touching every importing file.
      "effect/process": ["./test/shims/process.ts"],
      "effect/http": ["./test/shims/http.ts"],
      "effect/http/HttpServer": ["./test/shims/http-server.ts"],
      "effect/http-api": ["./test/shims/http-api.ts"],
      "effect/socket/Socket": ["./test/shims/socket.ts"]
    }
  },
  "include": ["src", "test", "script"],
  "exclude": ["skills", "node_modules", "dist"]
}
