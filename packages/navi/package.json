{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.8",
  "name": "navi-ai-agent",
  "description": "Navi - AI coding IDE & CLI with parallel agent execution",
  "type": "module",
  "license": "MIT",
  "author": "Pankaj",
  "homepage": "https://github.com/pankaj1998a/navi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pankaj1998a/navi.git"
  },
  "bugs": {
    "url": "https://github.com/pankaj1998a/navi/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "coding",
    "agent",
    "terminal",
    "tui",
    "llm",
    "claude",
    "gpt",
    "gemini",
    "copilot",
    "navi"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --workers=4",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "build": "bun run script/build.ts",
    "build:single": "bun run script/build.ts --single",
    "dev": "bun run --conditions=browser ./src/index.ts",
    "package:portable": "bun run script/package-portable.ts",
    "package:portable:fast": "bun run script/package-portable.ts --skip-build",
    "db": "bun drizzle-kit"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#db": {
      "bun": "./src/storage/db.bun.ts",
      "node": "./src/storage/db.node.ts",
      "default": "./src/storage/db.bun.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
